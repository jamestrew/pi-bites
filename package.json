{
  "name": "pi-bites",
  "version": "0.1.0",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "pi -e ./src/index.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "check": "bun run lint && bun run fmt && bun run typecheck"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "^7.0.0-dev.20260429.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "typebox": "*"
  },
  "packageManager": "bun@1.3.11",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
