{
  "name": "pi-subagents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "pi -e ./src/index.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run fmt:check && bun run typecheck"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "0.68.0",
    "@mariozechner/pi-tui": "0.68.0",
    "@sinclair/typebox": "0.34.49",
    "@types/node": "25.6.0",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.3.11"
}
