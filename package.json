{
  "name": "pi-bites",
  "version": "0.1.0",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "dev": "pi -ne -e ./packages/ext/index.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run packages",
    "check": "bun run lint && bun run fmt && bun run typecheck && bun run test",
    "update:pi": "./scripts/update-pi.sh"
  },
  "dependencies": {
    "@ff-labs/fff-node": "0.9.6",
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.26.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.6.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "packageManager": "bun@1.3.11",
  "pi": {
    "extensions": [
      "./packages/ext/index.ts"
    ],
    "skills": [
      "./packages/ext/ponytail/skills"
    ]
  }
}
